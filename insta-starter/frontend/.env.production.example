# Variables de entorno para producción (GCP)

# API URL (Cloud Run)
VITE_API_URL=https://red-o-backend-xxxxxxxxxx-uc.a.run.app/api

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=tu-google-client-id

# reCAPTCHA Site Key
VITE_RECAPTCHA_SITE_KEY=tu-recaptcha-site-key

# Cloud Storage URL para imágenes (opcional)
VITE_GCS_IMAGES_URL=https://storage.googleapis.com/red-o-images-prod

# URL base para archivos estáticos (opcional - solo si difiere del API)
# VITE_STATIC_URL=https://storage.googleapis.com/red-o-images-prod
