# Variables de entorno para desarrollo local
# Copiar este archivo a .env y configurar los valores

# MongoDB
MONGODB_URI=mongodb://localhost:27017/redodb
MONGO_URI=mongodb://localhost:27017/redodb

# JWT
JWT_SECRET=tu-jwt-secret-aqui-cambiar-en-produccion
SESSION_SECRET=tu-session-secret-aqui-cambiar-en-produccion

# Google OAuth
GOOGLE_CLIENT_ID=tu-google-client-id
GOOGLE_CLIENT_SECRET=tu-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3002/api/auth/google/callback

# reCAPTCHA
RECAPTCHA_SECRET_KEY=tu-recaptcha-secret-key

# Frontend URL para CORS
FRONTEND_URL=http://localhost:5173

# Cloud Storage (solo para producción)
# USE_GCS=false
# GCS_BUCKET=red-o-images-prod

# Puerto del servidor
PORT=3002

# Entorno
NODE_ENV=development
